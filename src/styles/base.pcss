*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body {
  height: 100%;
  margin: 0;
}

body {
  font-family: var(--font-family);
  font-size: var(--font-size-m);
  line-height: 1.4;
  color: var(--color-text);
  background: var(--color-surface);
}

#app {
  height: 100%;
}

h1,
h2,
h3,
p,
ul {
  margin: 0;
}

ul {
  padding: 0;
  list-style: none;
}

button,
input {
  font: inherit;
  color: inherit;
}

button {
  cursor: pointer;
}

:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}

.page {
  min-height: 100%;
  padding: var(--space-l);

  &--centered {
    display: flex;
    align-items: center;
    justify-content: center;
  }
}

.link {
  color: var(--color-primary);
  text-decoration: none;

  &:hover {
    text-decoration: underline;
  }

  &--muted {
    color: var(--color-muted);
  }

  &--danger {
    color: var(--color-danger);
  }
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

.icon-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  padding: 0;
  color: var(--color-muted);
  background: none;
  border: none;
  border-radius: var(--radius-round);

  &:hover {
    color: var(--color-primary);
    background: var(--color-accent-soft);
  }
}
