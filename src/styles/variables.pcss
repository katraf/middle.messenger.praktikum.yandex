:root {
  --color-primary: #3369f3;
  --color-primary-hover: #2858d6;
  --color-text: #1e1e1e;
  --color-muted: #999;
  --color-border: #eaeaea;
  --color-surface: #fff;
  --color-background: #fbfbfb;
  --color-input: #efefef;
  --color-accent-soft: #e4edfd;
  --color-danger: #ff2f2f;

  --font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  --font-size-xs: 11px;
  --font-size-s: 12px;
  --font-size-m: 13px;
  --font-size-l: 15px;
  --font-size-xl: 20px;

  --space-xs: 4px;
  --space-s: 8px;
  --space-m: 16px;
  --space-l: 24px;
  --space-xl: 40px;

  --radius-s: 8px;
  --radius-m: 12px;
  --radius-l: 30px;
  --radius-round: 50%;

  --shadow-card: 0 0 6px rgb(0 0 0 / 14%);
  --sidebar-width: 310px;
}
