.profile-page {
  display: flex;
  min-height: 100%;

  &__back {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 64px;
    background: var(--color-background);
    border-right: 1px solid var(--color-border);
  }

  &__back-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: var(--color-surface);
    background: var(--color-primary);
    border-radius: var(--radius-round);

    &:hover {
      background: var(--color-primary-hover);
    }
  }
}

.profile {
  display: flex;
  flex-grow: 1;
  flex-direction: column;
  gap: var(--space-l);
  align-items: center;
  max-width: 510px;
  margin: 0 auto;
  padding: var(--space-xl) var(--space-m);

  &__avatar-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    align-items: center;
  }

  &__avatar {
    position: relative;
    cursor: pointer;
  }

  &__avatar-hint {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-m);
    font-size: var(--font-size-s);
    color: var(--color-surface);
    text-align: center;
    background: rgb(0 0 0 / 50%);
    border-radius: var(--radius-round);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  &__avatar:hover &__avatar-hint,
  &__avatar:focus-within &__avatar-hint {
    opacity: 1;
  }

  &__name {
    font-size: 16px;
    font-weight: 600;
  }

  &__section {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    width: 100%;
  }

  &__subtitle {
    font-size: var(--font-size-l);
    font-weight: 500;
  }
}
