<div class="profile-page">
  <nav class="profile-page__back" aria-label="Навигация">
    {{{ Link href=backHref icon="back" label="Вернуться к чатам" className="profile-page__back-link" }}}
  </nav>

  <main class="profile">
    <form class="profile__avatar-form" name="avatar">
      <label class="profile__avatar">
        {{{ Avatar size="large" src=avatarSrc alt=userName }}}
        <span class="profile__avatar-hint">Поменять аватар</span>
        <input class="visually-hidden" type="file" name="avatar" accept="image/*">
      </label>
      <p class="form-status" ref="avatarStatus" aria-live="polite"></p>
      {{{ Button text="Загрузить" type="submit" variant="small" }}}
    </form>

    <h1 class="profile__name">{{userName}}</h1>

    <form class="profile__section" name="profile" novalidate>
      <h2 class="visually-hidden">Личные данные</h2>
      <ul>
        {{#each profileFields}}
          <li>{{{ Field this }}}</li>
        {{/each}}
      </ul>
      <p class="form-status" ref="profileStatus" aria-live="polite"></p>
      {{{ Button text="Сохранить" type="submit" }}}
    </form>

    <form class="profile__section" name="password" novalidate>
      <h2 class="profile__subtitle">Изменить пароль</h2>
      <ul>
        {{#each passwordFields}}
          <li>{{{ Field this }}}</li>
        {{/each}}
      </ul>
      <p class="form-status" ref="passwordStatus" aria-live="polite"></p>
      {{{ Button text="Изменить пароль" type="submit" }}}
    </form>

    <nav class="profile__account" aria-label="Аккаунт">
      {{{ Button text="Выйти" variant="danger" onClick=onLogout }}}
      <p class="form-status" ref="logoutStatus" aria-live="polite"></p>
    </nav>
  </main>
</div>
