<div class="messenger">
  <aside class="messenger__sidebar sidebar">
    <nav class="sidebar__nav" aria-label="Меню">
      {{{ Link href=settingsHref text="Профиль ›" variant="muted" }}}
    </nav>
    <form class="sidebar__search" name="search" role="search">
      <input class="sidebar__search-input" type="search" name="title" value="{{searchQuery}}" placeholder="Поиск" aria-label="Поиск по названию чата">
    </form>
    <form class="sidebar__create" name="create-chat" novalidate>
      <input class="sidebar__create-input" type="text" name="title" placeholder="Название нового чата" aria-label="Название нового чата" autocomplete="off">
      {{{ Button text="Создать" type="submit" variant="small" }}}
    </form>
    <p class="form-status sidebar__status" ref="sidebarStatus" aria-live="polite"></p>
    {{#if chats.length}}
      <ul class="sidebar__chats">
        {{#each chats}}
          <li>{{{ ChatItem this }}}</li>
        {{/each}}
      </ul>
    {{else}}
      <p class="sidebar__empty">{{#if searchQuery}}Ничего не нашлось{{else}}Чатов пока нет — создайте первый{{/if}}</p>
    {{/if}}
  </aside>

  <main class="messenger__dialog dialog">
    {{#if activeChat}}
      <header class="dialog__header">
        {{{ Avatar size="small" src=activeChat.avatarSrc alt=activeChat.title }}}
        <h1 class="dialog__title">{{activeChat.title}}</h1>
        <button class="icon-button{{#if isMembersOpen}} icon-button--active{{/if}}" type="button" data-action="toggle-members" aria-expanded="{{#if isMembersOpen}}true{{else}}false{{/if}}" aria-controls="chat-members" aria-label="Участники чата">
          <svg width="4" height="16" viewBox="0 0 4 16" fill="currentColor" aria-hidden="true">
            <circle cx="2" cy="2" r="1.5"/><circle cx="2" cy="8" r="1.5"/><circle cx="2" cy="14" r="1.5"/>
          </svg>
        </button>
      </header>

      {{#if isMembersOpen}}
        <section class="members" id="chat-members" aria-labelledby="members-title">
          <h2 class="members__title" id="members-title">Участники</h2>
          <ul class="members__list">
            {{#each members}}
              <li class="members__item">
                <span class="members__name">{{name}}</span>
                <span class="members__login">{{login}}</span>
                {{#if isMe}}
                  <span class="members__me">это вы</span>
                {{else}}
                  {{{ Button text="Удалить" variant="danger" onClick=onRemove }}}
                {{/if}}
              </li>
            {{/each}}
          </ul>
          <form class="members__add" name="add-user" novalidate>
            <input class="members__input" type="text" name="login" placeholder="Логин пользователя" aria-label="Логин пользователя" autocomplete="off">
            {{{ Button text="Добавить" type="submit" variant="small" }}}
          </form>
          <p class="form-status" ref="membersStatus" aria-live="polite"></p>
          {{#if activeChat.canDelete}}
            <div class="members__danger">
              {{{ Button text="Удалить чат" variant="danger" onClick=onDeleteChat }}}
            </div>
          {{/if}}
        </section>
      {{/if}}

      <section class="dialog__feed" aria-label="Переписка">
        <p class="dialog__empty">Сообщений пока нет</p>
      </section>

      <form class="dialog__composer composer" name="message" novalidate>
        <button class="icon-button" type="button" aria-label="Прикрепить файл">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 11.5 12.5 20a6 6 0 0 1-8.5-8.5L12.5 3a4 4 0 0 1 5.7 5.7L9.6 17.2a2 2 0 0 1-2.8-2.8L14.5 6.7"/>
          </svg>
        </button>
        {{{ Input className="composer__input" name="message" placeholder="Сообщение" label="Сообщение" autocomplete="off" }}}
        <button class="composer__send" type="submit" aria-label="Отправить">
          <svg width="14" height="12" viewBox="0 0 14 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M1 6h11M8 1l5 5-5 5"/>
          </svg>
        </button>
      </form>
    {{else}}
      <p class="dialog__placeholder">Выберите чат или создайте новый</p>
    {{/if}}
  </main>
</div>
