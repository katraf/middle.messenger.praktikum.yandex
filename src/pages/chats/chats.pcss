.messenger {
  display: flex;
  height: 100%;
}

.sidebar {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  width: var(--sidebar-width);
  background: var(--color-background);
  border-right: 1px solid var(--color-border);

  &__nav {
    padding: var(--space-m) 10px var(--space-s);
    font-size: var(--font-size-s);
    text-align: right;
  }

  &__search {
    padding: 0 10px var(--space-m);
  }

  &__search-input {
    width: 100%;
    height: 32px;
    padding: 0 var(--space-s);
    font-size: var(--font-size-s);
    text-align: center;
    background: var(--color-input);
    border: none;
    border-radius: 5px;
    outline: none;

    &:focus {
      text-align: left;
    }
  }

  &__chats {
    flex-grow: 1;
    overflow-y: auto;
  }
}

.dialog {
  display: flex;
  min-width: 0;
  flex-grow: 1;
  flex-direction: column;
  padding: 0 var(--space-m);

  &__header {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-border);
  }

  &__title {
    flex-grow: 1;
    font-size: var(--font-size-m);
    font-weight: 600;
  }

  &__feed {
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    gap: var(--space-l);
    padding: var(--space-l) 0;
    overflow-y: auto;
  }

  &__date {
    font-size: var(--font-size-s);
    color: var(--color-muted);
    text-align: center;
  }

  &__messages {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
}

.composer {
  display: flex;
  gap: 10px;
  align-items: center;
  padding: 10px 0;
  border-top: 1px solid var(--color-border);

  &__input {
    min-width: 0;
    flex-grow: 1;
    height: 32px;
    padding: 0 var(--space-m);
    font-size: var(--font-size-s);
    background: var(--color-input);
    border: none;
    border-radius: var(--radius-l);
    outline: none;
  }

  &__send {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    color: var(--color-surface);
    background: var(--color-primary);
    border: none;
    border-radius: var(--radius-round);

    &:hover {
      background: var(--color-primary-hover);
    }
  }
}

@media (width <= 720px) {
  .sidebar {
    display: none;
  }
}
