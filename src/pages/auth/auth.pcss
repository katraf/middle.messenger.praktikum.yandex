.auth-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 340px;
  min-height: 450px;
  padding: var(--space-xl) 30px var(--space-l);
  background: var(--color-surface);
  border-radius: var(--radius-m);
  box-shadow: var(--shadow-card);

  &__title {
    margin-bottom: var(--space-l);
    font-size: var(--font-size-xl);
    font-weight: 500;
    text-align: center;
  }

  &__form {
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  &__fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  &__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    align-items: center;
  }

  &__link {
    font-size: var(--font-size-s);
  }
}
