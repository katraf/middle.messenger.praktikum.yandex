<main class="page page--centered">
  <section class="auth-card">
    <h1 class="auth-card__title">{{title}}</h1>
    <form class="auth-card__form" name="{{formName}}" novalidate>
      <div class="auth-card__fields">
        {{#each fields}}
          {{{ Field this }}}
        {{/each}}
      </div>
      <div class="auth-card__actions">
        <p class="form-status" ref="status" aria-live="polite"></p>
        {{{ Button text=submitText type="submit" }}}
        {{{ Link href=linkHref text=linkText className="auth-card__link" }}}
      </div>
    </form>
  </section>
</main>
