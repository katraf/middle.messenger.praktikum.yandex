<main class="page page--centered">
  <section class="error">
    <h1 class="error__code">{{code}}</h1>
    <p class="error__text">{{text}}</p>
    {{#if reload}}
      <a class="link" href="{{backHref}}">{{backText}}</a>
    {{else}}
      {{{ Link href=backHref text=backText }}}
    {{/if}}
  </section>
</main>
