.avatar {
  display: block;
  flex-shrink: 0;
  width: 47px;
  height: 47px;
  overflow: hidden;
  background: var(--color-input);
  border-radius: var(--radius-round);

  &--small {
    width: 34px;
    height: 34px;
  }

  &--large {
    width: 130px;
    height: 130px;
  }

  &__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
}
