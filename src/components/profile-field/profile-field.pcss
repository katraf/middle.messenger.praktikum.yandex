.profile-field {
  display: flex;
  gap: var(--space-m);
  align-items: center;
  justify-content: space-between;
  padding: var(--space-s) 0;
  border-bottom: 1px solid var(--color-border);

  &__label {
    flex-shrink: 0;
  }

  &__input {
    min-width: 0;
    flex-grow: 1;
    padding: 0;
    color: var(--color-muted);
    text-align: right;
    background: none;
    border: none;
    outline: none;

    &:focus {
      color: var(--color-text);
    }
  }
}
