<label class="field field--{{#if variant}}{{variant}}{{else}}floating{{/if}}">
  {{{ Input
    className="field__input"
    name=name
    type=type
    value=value
    autocomplete=autocomplete
    onBlur=onBlur
    ref="input"
  }}}
  <span class="field__label">{{label}}</span>
  <span class="field__error" aria-live="polite">{{error}}</span>
</label>
