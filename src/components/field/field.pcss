.field {
  display: flex;
  flex-direction: column;

  &__input {
    min-width: 0;
    padding: 0;
    background: none;
    border: none;
    outline: none;
  }

  &__error {
    min-height: 14px;
    font-size: var(--font-size-xs);
    color: var(--color-danger);
  }
}

/* Вход и регистрация: подпись лежит в поле и всплывает при вводе */
.field--floating {
  position: relative;
  padding-top: var(--space-m);

  & .field__input {
    padding: var(--space-xs) 0 var(--space-s);
    border-bottom: 1px solid var(--color-primary);

    &:focus {
      margin-bottom: -1px;
      border-bottom-width: 2px;
    }
  }

  & .field__label {
    position: absolute;
    top: calc(var(--space-m) + var(--space-xs));
    left: 0;
    color: var(--color-muted);
    pointer-events: none;
    transition: top 0.15s ease, font-size 0.15s ease;
  }

  & .field__input:focus + .field__label,
  & .field__input:not(:placeholder-shown) + .field__label {
    top: 0;
    font-size: var(--font-size-xs);
  }

  & .field__error {
    margin-top: var(--space-xs);
  }
}

/* Настройки профиля: подпись слева, значение справа */
.field--profile {
  display: grid;
  grid-template-areas:
    'label input'
    'error error';
  grid-template-columns: auto 1fr;
  gap: 0 var(--space-m);
  align-items: center;
  padding: var(--space-s) 0 0;
  border-bottom: 1px solid var(--color-border);

  & .field__label {
    grid-area: label;
  }

  & .field__input {
    grid-area: input;
    color: var(--color-muted);
    text-align: right;

    &:focus {
      color: var(--color-text);
    }
  }

  & .field__error {
    grid-area: error;
    padding: var(--space-xs) 0;
    text-align: right;
  }
}
